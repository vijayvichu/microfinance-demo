# Copy this file to .env and fill in real values. Never commit .env.

# TiDB Cloud Serverless
DB_HOST=your-cluster.gateway.<region>.prod.aws.tidbcloud.com
DB_USER=your-username
DB_PASSWORD=your-password
DB_NAME=quickloan
DB_PORT=4000

# Comma-separated list of admin emails allowed to read /admin/users
ADMIN_EMAILS=admin@example.com

# Credentials used by backend/create-admin.js when seeding the admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Admin

# Comma-separated hostnames the SQL scanner is permitted to probe.
# Configure this on the Cloud Functions deployment, not in source control.
SCAN_ALLOWED_HOSTS=your-app.web.app,your-app.firebaseapp.com
